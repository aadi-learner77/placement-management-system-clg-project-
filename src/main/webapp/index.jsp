<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Placement Tracking Portal</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>

<div class="navbar">
    <h2>Placement Tracking System</h2>
    <div class="nav-links">
        <a href="login.jsp" class="btn">Login</a>
        <a href="register.jsp" class="btn btn-secondary">Register</a>
    </div>
</div>

<div class="container">
    <div class="hero">
        <h1>Simplify Campus Placements</h1>
        <p>A unified platform for students to find job drives, track applications, and coordinators to screen eligibility, manage drives, and shortlist candidates seamlessly.</p>
        
        <div class="hero-actions">
            <a href="login.jsp" class="btn">Access the Portal</a>
            <a href="register.jsp" class="btn btn-secondary">Student Registration</a>
        </div>
    </div>

    <div class="stats-grid" style="margin-top: 40px;">
        <div class="box">
            <h3>Placement Rate</h3>
            <p>85%</p>
            <span style="color: var(--text-secondary); font-size: 0.9rem;">Consistent placement success</span>
        </div>
        <div class="box">
            <h3>Top Companies</h3>
            <p>50+</p>
            <span style="color: var(--text-secondary); font-size: 0.9rem;">Active recruiters on platform</span>
        </div>
        <div class="box">
            <h3>Highest Package</h3>
            <p>30 LPA</p>
            <span style="color: var(--text-secondary); font-size: 0.9rem;">Industry leading offers</span>
        </div>
        <div class="box">
            <h3>Students Placed</h3>
            <p>1,200+</p>
            <span style="color: var(--text-secondary); font-size: 0.9rem;">Alumni network globally</span>
        </div>
    </div>
</div>

</body>
</html>
